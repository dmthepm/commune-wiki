{
  "name": "commune-publish",
  "type": "module",
  "version": "1.0.0",
  "description": "An Astro wiki engine with WikiLinks, sliding panes, backlinks and static search, plus a commune CLI that queries the content graph and checks links",
  "license": "MIT",
  "bin": {
    "commune": "bin/commune.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmthepm/commune-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/dmthepm/commune-wiki/issues"
  },
  "homepage": "https://github.com/dmthepm/commune-wiki#readme",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/test-search-index.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.10",
    "astro": "^7.2.10",
    "autoprefixer": "^10.4.16",
    "github-slugger": "^2.0.0",
    "globby": "^14.0.0",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^3.4.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "puppeteer": "^24.25.0",
    "typescript": "^5.6.0"
  }
}

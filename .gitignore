# Dependencies
# Both spellings: in a git worktree `node_modules` is a symlink to the main
# checkout's, and the trailing-slash form does not match a symlink.
node_modules
node_modules/
.pnp
.pnp.js

# Build output
# `dist/` is Astro's, and `astro build` empties it before every run; `lib/` is
# the compiled package (tsc), which is why it is not written there.
dist/
lib/
.astro/

# Environment
.env
.env.local
.env.production

# macOS
.DS_Store

# IDEs
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# The fixture consumer's generated artifacts. The integration writes
# `backlinks.json` into the public directory as well as into `dist/`, for dev
# server parity; in the fixture that directory holds nothing else, so it is
# output and not source.
tests/fixtures/consumer/public/

# Filtered docs (generated at build time)
src/content/docs/**
!src/content/docs/index.mdx


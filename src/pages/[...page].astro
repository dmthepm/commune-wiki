---
/**
 * Renders every entry in the `pages` collection at the `url` it declares.
 *
 * Standalone editorial pages live outside /notes/ and /research/ but still need
 * to be findable: registering them as a collection puts them in the search
 * index and makes them valid `[[WikiLink]]` targets. This catch-all is what
 * turns that metadata into an actual route.
 *
 * More specific routes win over a rest parameter, so /notes/*, /research/* and
 * /updates/* are unaffected.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Header from '../components/Header.astro';
import SearchModal from '../components/SearchModal.astro';
import Footer from '../components/Footer.astro';
import MarkdownLink from '../components/MarkdownLink.astro';
import { toMarkdownHref } from '../lib/graph.ts';
import StarredLinksScript from '../components/StarredLinksScript.astro';
import '../site.css';
import '../styles/design-system.css';
import '../styles/notes.css';

export async function getStaticPaths() {
	const pages = await getCollection('pages');
	return pages.map((entry) => ({
		// `url` is authoritative and schema-checked as /.../ — strip the slashes
		// back off to get the route param Astro wants.
		params: { page: entry.data.url.replace(/^\/|\/$/g, '') },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{data.title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={data.summary} />

  <!-- Open Graph -->
  <meta property="og:title" content={data.title} />
  <meta property="og:description" content={data.summary} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={Astro.url} />

  <link rel="icon" type="image/png" href="/favicon-32x32.png" />
</head>
<body>
  <Header />
  <SearchModal />

  <main id="main" style="max-width: 65ch; margin: 0 auto; padding: 2rem 1.5rem; min-height: calc(100vh - 200px);">
    <article class="prose">
      <h1>{data.title}</h1>
      <Content />
    </article>

    <MarkdownLink href={toMarkdownHref(data.url)} />

    <Footer />
  </main>

  <StarredLinksScript />
</body>
</html>

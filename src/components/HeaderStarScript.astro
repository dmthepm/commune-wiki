    color: var(--c-text-accent);
    margin-bottom: 0.75rem;
  }

  .star-modal-body p:last-child {
    margin-bottom: 0;
  }

  .star-modal-body strong {
    color: var(--c-accent);
    font-weight: 600;
  }

  .star-modal-body em {

---
export interface Props { slug: string; title?: string; hideCount?: boolean; }
const { slug, hideCount = false } = Astro.props;
---
<!-- Starts hidden: the list is filled from `/backlinks.json` at runtime, so
     without JavaScript, or on a note nothing links to, the heading would
     otherwise stand over an empty list. `BacklinksScript` reveals it once it
     has links to show. -->
<aside class="backlinks hidden" data-backlinks-for={slug} data-hide-count={hideCount ? 'true' : undefined}>
  <h4>Links to this note</h4>
  <ul class="backlinks-list"></ul>
</aside>

<style>
  .backlinks{margin-top:3rem;padding-top:1.2rem;border-top:1px solid var(--c-border)}
  .backlinks.hidden{display:none}
  .backlinks h4{font-size:.85rem;color:var(--c-text-muted);margin:0 0 .8rem;font-weight:500}
  .backlinks li{margin:.4rem 0;font-size:.9rem}
  .backlinks a{opacity:.85}
  .backlinks a:hover{opacity:1}
</style>
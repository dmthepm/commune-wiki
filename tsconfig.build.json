{
	// The type gate, and the build that produces `lib/`.
	//
	// Deliberately not extending `tsconfig.json`: that one is Astro's
	// `strict` preset, which is tuned for the *site* — JSX, DOM libs, `.astro`
	// files, and `noEmit`. This one describes the Node-side package only, the
	// files a consumer runs outside an Astro process: the graph core, the CLI,
	// the two unified plugins and the integration.
	//
	// `lib/`, not `dist/`, because `dist/` is Astro's: `astro build` empties
	// its output directory before every run, so compiling the package there
	// means a site build deletes the CLI that is about to check it. Astro keeps
	// its default, which is what every consumer's host already expects.
	//
	// `rootDir: src` is what keeps the emitted tree flat (`lib/lib/graph.js` is
	// wrong-looking but right — `src/lib/graph.ts` in, `lib/lib/graph.js` out —
	// and `lib/cli/main.js` beside it), so `exports` can point at short paths
	// rather than `lib/src/...`. `rewriteRelativeImportExtensions` is what lets
	// the source keep its explicit `./x.ts` specifiers — which Node's type
	// stripping requires when it runs these files straight from the repo —
	// while the emitted JavaScript imports `./x.js`.
	//
	// No `sourceMap` or `declarationMap`: `files` ships the compiled output and
	// not the sources, so every map would point at a file that is not in the
	// tarball. The source is one click away in the repo.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "lib",
		"declaration": true,
		"rewriteRelativeImportExtensions": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	// Never `src/components`, `src/pages`, `src/content` or
	// `src/content.config.ts`: those are the site's, they are `.astro` or they
	// import `astro:*` virtual modules, and none of them ship compiled.
	"include": ["src/lib", "src/cli", "src/*.ts"],
	"exclude": ["src/env.d.ts", "src/content.config.ts"]
}

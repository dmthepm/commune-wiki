---
// The Commune mark: an open ring with one linked node in the gap.
interface Props { size?: number; class?: string }
const { size = 32, class: className = '' } = Astro.props;
---
<svg class={`mark ${className}`} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect class="mark-tile" width="32" height="32" rx="7" />
  <path class="mark-ring" d="M19.6 9.6a7.6 7.6 0 1 0 0 12.8" />
  <circle class="mark-node" cx="23.6" cy="16" r="2.4" />
</svg>

---
import { siteConfig } from '../site.config';
import Mark from './Mark.astro';
---
<footer class="site-footer">
  <p class="footer-giant" aria-hidden="true"><Mark size={120} /><span>{siteConfig.name}</span></p>
  <div class="footer-brand">
    <p>Open source. MIT. No account.</p>
  </div>
  <nav class="footer-links" aria-label="Footer">
    <a href="/#start">Start a wiki</a>
    <a href="/notes/small-notes/">Sample notes</a>
    <a href={`${siteConfig.repo}#readme`}>README</a>
    <a href={siteConfig.repo}>github.com/dmthepm/commune-wiki</a>
  </nav>
</footer>

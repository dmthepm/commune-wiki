---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans';
import '@dmthepm/commune/styles/design-system.css';
import '@dmthepm/commune/styles/notes.css';
import '../styles/site.css';
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { siteConfig } from '../site.config';
import Mark from '../components/Mark.astro';

interface Props {
  title: string;
  description?: string;
  home?: boolean;
}
const { title, description = siteConfig.description, home = false } = Astro.props;
const fullTitle = home ? `${siteConfig.name}: ${title}` : `${title} · ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
const ogImage = new URL('/og.png', siteConfig.url).href;
const ogAlt = 'Commune. Your notes deserve a life beyond the folder. Three linked notes drawn as a small graph.';
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#34192D" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    {home && <link rel="preload" href={serifItalicUrl} as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('anim');</script>
    <title>{fullTitle}</title>
  </head>
  <body class={home ? 'is-home' : 'is-note'}>
    <a class="site-skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-brand" href="/" aria-label={`${siteConfig.name}, home`}><Mark size={30} /><span>{siteConfig.name}</span></a>
      <nav aria-label="Main navigation">
        <a class="nav-start" href="/#start">Start</a>
        <a class="nav-demo" href="/notes/small-notes/">Demo</a>
        <a href={siteConfig.repo}>GitHub</a>
        {!home && (
          <button type="button" onclick="window.dispatchEvent(new CustomEvent('commune:openSearch'))">Search <kbd>⌘K</kbd></button>
        )}
      </nav>
    </header>
    <slot />
    <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) {
        const measure = () => document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
        measure();
        new ResizeObserver(measure).observe(header);
      }
    </script>
  </body>
</html>
